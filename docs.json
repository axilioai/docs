{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Axilio",
  "theme": "maple",
  "logo": {
    "light": "/logo/axilio-light.svg",
    "dark": "/logo/axilio-dark.svg",
    "href": "/"
  },
  "favicon": "/favicon.png",
  "colors": {
    "primary": "#10B981",
    "light": "#34D399",
    "dark": "#059669"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "dark": "#0A0A0A",
      "light": "#FFFFFF"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Sign up",
      "href": "https://axilio.ai"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Platform",
        "icon": "cloud",
        "groups": [
          {
            "group": "Get Started",
            "icon": "rocket",
            "pages": [
              "index",
              "introduction",
              "cli",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Phones and Sessions",
            "icon": "mobile",
            "pages": [
              "devices/overview",
              "devices/allocate",
              "devices/discover",
              "devices/dedicated",
              "devices/timeouts"
            ]
          },
          {
            "group": "Agents and Runs",
            "icon": "robot",
            "pages": [
              "agents/overview",
              "agents/create",
              "agents/run",
              "agents/pause-and-follow-up",
              "agents/schedules",
              "agents/monitor"
            ]
          },
          {
            "group": "Files",
            "icon": "folder-open",
            "pages": [
              "files/overview",
              "files/move-files",
              "files/session-captures"
            ]
          },
          {
            "group": "Webhooks",
            "icon": "bell",
            "pages": [
              "webhooks/overview",
              "webhooks/events"
            ]
          },
          {
            "group": "Observability",
            "icon": "video",
            "pages": [
              "observability/overview",
              "observability/live-view",
              "observability/recordings"
            ]
          },
          {
            "group": "Telemetry",
            "icon": "signal-stream",
            "pages": [
              "telemetry/overview",
              "telemetry/get-started",
              "telemetry/understand-a-trace",
              "telemetry/live",
              "telemetry/retrieve",
              "telemetry/frames",
              "telemetry/data-controls",
              "telemetry/reliability"
            ]
          },
          {
            "group": "Usage",
            "icon": "chart-line",
            "pages": [
              "usage/overview"
            ]
          },
          {
            "group": "Billing",
            "icon": "credit-card",
            "pages": [
              "billing/overview",
              "billing/balance-and-invoices",
              "billing/plans"
            ]
          },
          {
            "group": "Organization",
            "icon": "users",
            "pages": [
              "org/overview",
              "org/members",
              "platform/api-keys"
            ]
          },
          {
            "group": "Reference",
            "icon": "circle-info",
            "pages": [
              "reference/errors",
              "reference/configuration"
            ]
          }
        ]
      },
      {
        "tab": "Drivers",
        "icon": "hand-pointer",
        "groups": [
          {
            "group": "Drivers",
            "icon": "layer-group",
            "pages": [
              "drivers/overview"
            ]
          },
          {
            "group": "Mobile driver",
            "icon": "mobile",
            "pages": [
              "driver/overview",
              {
                "group": "Basics",
                "pages": [
                  "driver/find",
                  "driver/tap",
                  "driver/type",
                  "driver/swipe",
                  "driver/buttons",
                  "driver/observe",
                  "driver/wait",
                  "driver/screenshot"
                ]
              },
              {
                "group": "Reference",
                "pages": [
                  "driver/client",
                  "driver/reference",
                  "driver/locator",
                  "driver/element",
                  "driver/screen",
                  "driver/key"
                ]
              }
            ]
          },
          {
            "group": "Models",
            "pages": [
              "drivers/models"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "icon": "code",
        "groups": [
          {
            "group": "Overview",
            "icon": "circle-info",
            "pages": [
              "api-reference/overview",
              "api-reference/versioning",
              "api-reference/api-changes-2026-10"
            ]
          },
          {
            "group": "Device Control Protocol",
            "icon": "plug",
            "pages": [
              "api-reference/dcp/overview",
              "api-reference/dcp/raw-usage",
              "api-reference/dcp/reconnect",
              "api-reference/dcp/reference"
            ]
          },
          {
            "group": "REST API",
            "icon": "server",
            "openapi": {
              "source": "/api-reference/openapi-backend.json",
              "directory": "api-reference/rest"
            }
          },
          {
            "group": "Argus API",
            "icon": "eye",
            "openapi": "/api-reference/openapi-argus.json",
            "pages": [
              "api-reference/argus/list-models",
              "api-reference/argus/screenshots-detect",
              "api-reference/argus/screenshots-locate",
              "api-reference/argus/elements-locate"
            ]
          }
        ]
      },
      {
        "tab": "GitHub ↗",
        "href": "https://github.com/orgs/axilioai/repositories"
      },
      {
        "tab": "Dashboard ↗",
        "href": "https://app.axilio.ai/dashboard/axilio/sessions"
      }
    ]
  },
